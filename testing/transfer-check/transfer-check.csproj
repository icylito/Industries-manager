<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Reads a backups folder and key with the app's own code. See README: transfer check. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\api_v2\Backups\BackupSigner.cs" Link="BackupSigner.cs" />
    <Compile Include="..\..\api_v2\Backups\BackupCipher.cs" Link="BackupCipher.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.11" />
  </ItemGroup>

</Project>

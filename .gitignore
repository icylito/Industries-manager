# API build output
api_v2/bin/
api_v2/obj/
api_v2/artifacts/

# Has the database password, copy appsettings.Development.example.json to make yours
api_v2/appsettings.Development.json

# Seed script cache, and the local account the seed script signs in as
scripts/__pycache__/
testing/__pycache__/
scripts/seeding.control.toml

# Root editor settings, angular/.vscode stays shared for ng serve and ng test
/.vscode/

# Documents and notes
report.txt
HANDOFF.md

# Copies of the database made by the nightly backup, only the root folder (api_v2/Backups is code)
/backups/
/scratchpad-files/
# The readable JSON copy of every table from the Tables page, the API writes it (UserTables:Mirror)
/user-tables/
# The key that signs backups. Whoever holds it can make a backup the app trusts, keep it out of the repo
/backup-key/

# The checks in testing/: the throwaway API's settings and its backups
api_v2/appsettings.Throwaway.json
/testing/throwaway-backups/

# The page's copy of the https development certificate, start.bat https and share make it
angular/.cert/

# Front-end related

# The page checks in testing/ (playwright), installed there and not part of the repo
testing/node_modules/
# Downloaded by the page checks: Playwright's browsers (over 200 MB, GitHub refuses it), the npm cache and the debug log
testing/.pw-browsers/
testing/.npm-cache/
testing/debug.log

# Screenshots saved while checking the page, regenerated every run
/shots/

# Plan workspaces for the subagent-driven runs (scratch, not part of the project)
.superpowers/

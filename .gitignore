# API build output
api_v2/bin/
api_v2/obj/
api_v2/artifacts/

# Has the database password, copy appsettings.Development.example.json to make yours
api_v2/appsettings.Development.json

# Seed script cache, and the local account the seed script signs in as
scripts/__pycache__/
scripts/seeding.control.toml

# Copies of the database made by the nightly backup, only the root folder (api_v2/Backups is code)
/backups/
/scratchpad-files/
# The readable JSON copy of every table from the Tables page, the API writes it (UserTables:Mirror)
/user-tables/
# The key that signs backups. Whoever holds it can make a backup the app trusts, keep it out of the repo
/backup-key/

# Dumps, zips and the temp copies a restore or download makes, wherever they land
*.dump
*.zip
.plain-*
*.sealing

# The checks in testing/: the throwaway API's settings and its backups
api_v2/appsettings.Throwaway.json

# The page's copy of the https development certificate, start.bat https and share make it
angular/.cert/

# Design files, planning notes, handoffs and grading rubrics: each machine keeps its own, not in git
/design/
